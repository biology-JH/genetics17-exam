# Local-only values for testing; real production values are stored in Vercel project settings.
HOMEWORK_PASSWORD=replace-with-a-local-test-value
MARKING_PASSWORD=replace-with-a-local-test-value
SESSION_SIGNING_SECRET=replace-with-a-random-local-test-secret
ANSWER_KEY_JSON={}
# Optional local-only helper: base64-encoded JSON is decoded by vite.config.ts.
ANSWER_KEY_JSON_B64=
# Vercel Production may store ANSWER_KEY_JSON as gzip64:<base64(gzip(UTF-8 JSON))>;
# the Node grading handler decodes it server-side to fit Vercel's per-deployment environment limit.

# Optional LLM rubric grader; configure these only in server-side local/Vercel environments.
# Keep the API key out of client-prefixed variables such as VITE_*.
GENETICS_OPENAI_API_KEY=
GENETICS_OPENAI_MODEL=gpt-4o-mini
