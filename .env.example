# Local-only values for testing; real production values are stored in Vercel project settings.
HOMEWORK_PASSWORD=replace-with-a-local-test-value
MARKING_PASSWORD=replace-with-a-local-test-value
SESSION_SIGNING_SECRET=replace-with-a-random-local-test-secret
ANSWER_KEY_JSON={}
# Optional local-only helper: base64-encoded JSON is decoded by vite.config.ts; Vercel uses raw ANSWER_KEY_JSON.
ANSWER_KEY_JSON_B64=
